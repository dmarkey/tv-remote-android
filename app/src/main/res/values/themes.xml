<resources>
    <!-- Pure black so the launch frame matches the AMOLED UI (no white flash). -->
    <style name="Theme.TvRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
